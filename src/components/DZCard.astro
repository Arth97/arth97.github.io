---
import { Image } from 'astro:assets';
const { t } = Astro.props;

const DZProject = {
  title: "DayZ Map Editor (Work In Progress)",
  description: t.projects.descriptions.dayzMapEditorDescription,
  techIcon: ["react", "threejs", "nodejs", "express", "mongodb", "mongoose", "typescript", "tailwindcss", "vitejs", ],
  carouselImages: [
    { src: "/dzProject/MainConMapa.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/MainConMascara.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/LayoutGen.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/Preview2D.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/SeleccionCasas.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/LayoutBuldozer1.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/LayoutBuldozer2.jpg", alt: "DayZ Editor - Vista principal" },

    { src: "/dzProject/DibujandoClusterSample.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/SelectorAssetsArboles.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/GeneracionVegetacion.jpg", alt: "DayZ Editor - Vista principal" },
    { src: "/dzProject/BuldozerClust1.jpg", alt: "DayZ Editor - Vista principal" },
  ],
  codeLink: "",
  demoLink: "",
  category: "dzeditor"
}
---

<div class="project-card" data-category={DZProject.category}>
  <div class="project-image">
    <div class="carousel">
      <button class="carousel-btn carousel-btn--prev" aria-label="Imagen anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      
      <div class="carousel-track">
        {/* Clone: last image (for seamless prev from first) */}
        <img src={DZProject.carouselImages[4].src} alt={DZProject.carouselImages[4].alt} loading="lazy" />
        
        {/* 5 Real images */}
        {DZProject.carouselImages.map((img, i) => (
          <img src={img.src} alt={img.alt} loading={i === 0 ? "eager" : "lazy"} />
        ))}
        
        {/* Clone: first image (for seamless next from last) */}
        <img src={DZProject.carouselImages[0].src} alt={DZProject.carouselImages[0].alt} loading="lazy" />
      </div>
      
      <button class="carousel-btn carousel-btn--next" aria-label="Siguiente imagen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
      
      <div class="carousel-indicators" aria-label="Navegación de imágenes">
        {DZProject.carouselImages.map((_, i) => (
          <button class="carousel-indicator" data-index={i} aria-label={`Ir a imagen ${i + 1}`}></button>
        ))}
      </div>
    </div>
    
		{(DZProject.codeLink !== "" || DZProject.demoLink !== "") && (
    	<div class="project-overlay">
				<div class="project-links">
					<a href={DZProject.codeLink} class="project-link" title="Ver código" target="_blank" rel="noopener">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
							<path fill-rule="evenodd" d="M14.447 3.026a.75.75 0 0 1 .527.921l-4.5 16.5a.75.75 0 0 1-1.448-.394l4.5-16.5a.75.75 0 0 1 .921-.527ZM16.72 6.22a.75.75 0 0 1 1.06 0l5.25 5.25a.75.75 0 0 1 0 1.06l-5.25 5.25a.75.75 0 1 1-1.06-1.06L21.44 12l-4.72-4.72a.75.75 0 0 1 0-1.06Zm-9.44 0a.75.75 0 0 1 0 1.06L2.56 12l4.72 4.72a.75.75 0 0 1-1.06 1.06L.97 12.53a.75.75 0 0 1 0-1.06l5.25-5.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
						</svg>					
					</a>
					<a href={DZProject.demoLink} class="project-link" title="Ver demo" target="_blank" rel="noopener">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
							<path fill-rule="evenodd" d="M2.25 5.25a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3V15a3 3 0 0 1-3 3h-3v.257c0 .597.237 1.17.659 1.591l.621.622a.75.75 0 0 1-.53 1.28h-9a.75.75 0 0 1-.53-1.28l.621-.622a2.25 2.25 0 0 0 .659-1.59V18h-3a3 3 0 0 1-3-3V5.25Zm1.5 0v7.5a1.5 1.5 0 0 0 1.5 1.5h13.5a1.5 1.5 0 0 0 1.5-1.5v-7.5a1.5 1.5 0 0 0-1.5-1.5H5.25a1.5 1.5 0 0 0-1.5 1.5Z" clip-rule="evenodd" />
						</svg>					
					</a>
				</div>
    	</div>
		)}
  </div>
  <div class="project-content">
    <h3 class="project-title">{DZProject.title}</h3>
    <p class="project-description">{DZProject.description}</p>
    <div class="project-tech">
      {DZProject.techIcon.map((t: any) => (
				<Image src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${t}/${t}-original.svg`} alt={`${t}`} loading="eager" width="35" height="35" /> 
      ))}
    </div>
  </div>
</div>

<style>
	.project-card {
		background: white;
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: var(--shadow-md);
		transition: all 0.3s ease;
    margin-bottom: 2.5rem;
	}

	.project-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-xl);
	}

	.project-image {
		position: relative;
		max-height: 600px;
		overflow: hidden;
	}

	/* Carousel Styles */
	.carousel {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.carousel-track {
		display: flex;
		height: 100%;
		transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		will-change: transform;
	}

	.carousel-track img {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Navigation Buttons */
	.carousel-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		border: none;
		background: rgba(0, 0, 0, 0.4);
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		opacity: 0.6;
		transition: all 0.3s ease;
		z-index: 10;
	}

	.carousel-btn:hover,
	.carousel-btn:focus {
		opacity: 1;
		background: rgba(0, 0, 0, 0.7);
		transform: translateY(-50%) scale(1.1);
		outline: none;
	}

	.carousel-btn:focus-visible {
		box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.5);
	}

	.carousel-btn--prev { left: 1rem; }
	.carousel-btn--next { right: 1rem; }

	.carousel-btn svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	/* Indicators */
	.carousel-indicators {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.5rem;
		z-index: 10;
	}

	.carousel-indicator {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		border: none;
		background: rgba(255, 255, 255, 0.5);
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.carousel-indicator:hover {
		background: rgba(255, 255, 255, 0.8);
		transform: scale(1.2);
	}

	.carousel-indicator.active {
		background: white;
		transform: scale(1.3);
	}

	.project-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.8);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.3s ease;
		z-index: 5;
	}

	.project-card:hover .project-overlay {
		opacity: 1;
	}

	.project-links {
		display: flex;
		gap: 1.5rem;
	}

	.project-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		background: white;
		color: var(--color-primary);
		border-radius: 50%;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.project-link:hover {
		background: var(--color-secondary);
		color: white;
		transform: scale(1.1);
	}

	.project-content {
		padding: 2rem;
	}

	.project-title {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--color-primary);
		margin-bottom: 1rem;
	}

	.project-description {
		color: var(--color-text-light);
		line-height: 1.6;
		margin-bottom: 1.5rem;
		white-space: pre-line;
	}

	.project-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.tech-tag {
		background: var(--color-surface);
		color: var(--color-secondary);
		padding: 0.25rem 0.75rem;
		border-radius: 1rem;
		font-size: 0.875rem;
		font-weight: 500;
	}

	@media (max-width: 768px) {
		.project-content {
			padding: 1.5rem;
		}
		
		.carousel-btn {
			width: 3rem;
			height: 3rem;
		}
		
		.carousel-btn--prev { left: 0.5rem; }
		.carousel-btn--next { right: 0.5rem; }
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const carousel = document.querySelector<HTMLElement>('.carousel');
		if (!carousel) return;

		const trackElement = carousel.querySelector<HTMLElement>('.carousel-track');
		const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn--prev');
		const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn--next');
		const indicators = carousel.querySelectorAll<HTMLButtonElement>('.carousel-indicator');

		if (!trackElement || !prevBtn || !nextBtn) return;

		const track = trackElement;

		const slides = track.querySelectorAll<HTMLImageElement>('img');

		const slideCount = slides.length;
		const realSlides = 5;
		let currentIndex = 1;
		const slideWidth = 100;

		let autoSlideInterval: ReturnType<typeof setInterval> | undefined;
		let isTransitioning = false;

		function updateCarousel(animate = true): void {
			if (isTransitioning && animate) return;

			isTransitioning = animate;

			track.style.transition = animate
				? 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)'
				: 'none';

			track.style.transform = `translateX(-${currentIndex * slideWidth}%)`;

			const indicatorIndex =
				((currentIndex - 1) % realSlides + realSlides) % realSlides;

			indicators.forEach((ind, i) => {
				ind.classList.toggle('active', i === indicatorIndex);
			});

			if (animate) {
				setTimeout(() => {
					isTransitioning = false;
				}, 500);
			}
		}

		function goToSlide(
			indicatorIndex: number,
			animate = true
		): void {
			currentIndex = indicatorIndex + 1;
			updateCarousel(animate);
		}

		function next(): void {
			if (isTransitioning) return;

			currentIndex++;
			updateCarousel();

			if (currentIndex >= slideCount - 1) {
				setTimeout(() => {
					currentIndex = 1;
					updateCarousel(false);
				}, 500);
			}
		}

		function prev(): void {
			if (isTransitioning) return;

			currentIndex--;
			updateCarousel();

			if (currentIndex < 1) {
				setTimeout(() => {
					currentIndex = realSlides;
					updateCarousel(false);
				}, 500);
			}
		}

		nextBtn.addEventListener('click', next);
		prevBtn.addEventListener('click', prev);

		indicators.forEach((indicator, index) => {
			indicator.addEventListener('click', () => {
				goToSlide(index);
			});
		});

		carousel.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'ArrowRight') next();
			if (e.key === 'ArrowLeft') prev();
		});

		function startAutoSlide(): void {
			stopAutoSlide();
			autoSlideInterval = setInterval(next, 5000);
		}

		function stopAutoSlide(): void {
			if (autoSlideInterval !== undefined) {
				clearInterval(autoSlideInterval);
				autoSlideInterval = undefined;
			}
		}

		carousel.addEventListener('mouseenter', stopAutoSlide);
		carousel.addEventListener('mouseleave', startAutoSlide);
		carousel.addEventListener('focusin', stopAutoSlide);
		carousel.addEventListener('focusout', startAutoSlide);

		let startX = 0;
		let startY = 0;

		carousel.addEventListener(
			'touchstart',
			(e: TouchEvent) => {
				startX = e.touches[0].clientX;
				startY = e.touches[0].clientY;
			},
			{ passive: true }
		);

		carousel.addEventListener(
			'touchend',
			(e: TouchEvent) => {
				const diffX = startX - e.changedTouches[0].clientX;
				const diffY = startY - e.changedTouches[0].clientY;

				if (
					Math.abs(diffX) > Math.abs(diffY) &&
					Math.abs(diffX) > 50
				) {
					diffX > 0 ? next() : prev();
				}
			},
			{ passive: true }
		);

		updateCarousel(false);
		startAutoSlide();
	});
</script>
